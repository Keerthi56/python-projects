student_records = {}
def add_student(name, age, courses):
    if name in student_records:
        print(f"Student '{name}' already exits.")
    elif name not in student_records:
        student_records[name] = {"age": age, "grades": set(), "courses": set(courses) }
        print(f"Student '{name}' added successfully.")


def add_grade(name, grade):
    if name not in student_records:
        print(f"Student '{name}' not found.")
    elif name in student_records:
        student_records[name]["grades"].add(grade)
        print(f"Grade {grade} added for student '{name}'.")

def is_enrolled(name,course):
    if name not in student_records:
        print(f"Student '{name}' not found.")
        return False
    elif name in student_records:
        if course in student_records[name]["courses"]:
            return True
        else:
            return False

def calculate_average_grade(name):
    if name not in student_records:
        print(f"Student '{name}' not found.")
        return None
    elif name in student_records:
        grades = student_records[name]["grades"]
        if len(grades) == 0:
            return 0
        else:
            total = 0
            for grade in grades:
                total += grade
            avg = total/len(grades)
            return avg


def list_students_by_course(course):
    new_list = []
    for student in student_records:
        if course in student_records[student]["courses"]:
            new_list.append(student)
    return new_list
        
    
def filter_top_students(threshold):
    top_list = []
    for student in student_records:
        avg_grade = calculate_average_grade(student)
        if avg_grade > threshold:
            top_list.append(student)
    return top_list

add_student("Alice", 20, ["Math", "Physics"])
add_student("Bob", 22, ["Math", "Biology"])
add_student("Diana", 23, ["Chemistry", "Physics"])
add_grade("Alice", 90)
add_grade("Alice", 85)
add_grade("Bob", 75)
add_grade("Diana", 95)
print(filter_top_students(80))  # Should return ["Alice", "Diana"]
print(filter_top_students(90))  # Should return ["Diana"]
print(filter_top_students(100))  # Should return an empty list
